<Window x:Class="AppBox.App.Views.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AppBox.App.Controls" Title="AppBox" Width="468" Height="510" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="Manual">
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="25,22">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="APPBOX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,7,0,16" Foreground="{DynamicResource Muted}"/></StackPanel>
        <Button Grid.Column="1" Content="⚙" FontSize="20" Padding="10,3" VerticalAlignment="Top" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
        <Button Grid.Column="2" Content="×" FontSize="20" Padding="10,3" VerticalAlignment="Top" ToolTip="Dismiss" AutomationProperties.Name="Dismiss launcher" Click="Dismiss_Click"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,14"><ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" FontSize="23" FontWeight="SemiBold" AutomationProperties.Name="Folder"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Your first AppBox" FontSize="23" FontWeight="SemiBold" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFolders}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <ItemsControl ItemsSource="{Binding Applications}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Button Width="94" Height="108" Margin="3,5" Padding="5" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Entry.Target}" AutomationProperties.Name="{Binding Name}">
              <StackPanel><controls:AppIcon Width="48" Height="48" Margin="0,0,0,12"/><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="82" HorizontalAlignment="Center" Visibility="{Binding ShowName, Converter={StaticResource BoolVisibility}}"/></StackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="12,50"><TextBlock Text="A home for your everyday apps" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Create a folder and add apps to get started." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
        </Grid>
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Everything in its place." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋  Manage folders" Click="Manage_Click"/></Grid>
    </Grid>
  </Border>
</Window>

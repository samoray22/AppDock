<Window x:Class="AppBox.App.Views.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AppBox.App.Controls" Title="AppBox" Width="468" Height="274" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="Manual" AllowDrop="True" PreviewDragOver="Launcher_DragOver" PreviewDragLeave="Launcher_DragLeave" PreviewDrop="Launcher_Drop">
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <AdornerDecorator>
    <Border x:Name="Frame" BorderThickness="1" CornerRadius="16" Padding="25,22">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><DataTrigger Binding="{Binding ExternalDropActive}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource Hover}"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="HeaderPane"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="APPBOX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,7,0,16" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
          <Button Grid.Column="1" Content="{Binding EditButtonText}" Command="{Binding ToggleEditCommand}" VerticalAlignment="Top" Padding="12,7" AutomationProperties.Name="{Binding EditButtonText}"/>
          <Button Grid.Column="2" Content="⚙" FontSize="20" Padding="10,3" VerticalAlignment="Top" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
          <Button Grid.Column="3" Content="×" FontSize="20" Padding="10,3" VerticalAlignment="Top" ToolTip="Dismiss" AutomationProperties.Name="Dismiss launcher" Click="Dismiss_Click"/>
        </Grid>
        <Grid x:Name="FolderPane" Grid.Row="1" Margin="0,0,0,14"><ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" FontSize="23" FontWeight="SemiBold" AutomationProperties.Name="Folder" IsEnabled="{Binding HasFolders}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Your first AppBox" FontSize="23" FontWeight="SemiBold" IsHitTestVisible="False" Margin="18,8,32,8" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFolders}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="AppScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="AppScroller_ScrollChanged">
              <ItemsControl x:Name="AppGrid" ItemsSource="{Binding Applications}" Height="{Binding GridHeight}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Button Width="90" Height="108" Margin="3,5" Padding="5" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Entry.Target}" AutomationProperties.Name="{Binding Name}" PreviewMouseLeftButtonDown="Tile_MouseDown" PreviewMouseMove="Tile_MouseMove" ContextMenuOpening="Tile_ContextMenuOpening">
                  <Button.ContextMenu><ContextMenu><MenuItem Header="Open file location" Click="Location_Click"/><MenuItem Header="Rename display name" Click="Rename_Click"/><Separator/><MenuItem Header="Remove from folder" Click="Remove_Click"/></ContextMenu></Button.ContextMenu>
                  <StackPanel><controls:AppIcon Width="48" Height="48" Margin="0,0,0,12"/><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="82" HorizontalAlignment="Center" Visibility="{Binding ShowName, Converter={StaticResource BoolVisibility}}"/></StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="8,10"><TextBlock Text="A home for your everyday apps" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Click Edit to add apps, or manage your folders." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel>
          <Border Visibility="{Binding ExternalDropActive, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="20,14" IsHitTestVisible="False"><TextBlock Text="＋ Add applications" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
        <StackPanel x:Name="FooterPane" Grid.Row="3" Margin="0,12,0,0">
          <TextBlock Text="Drag icons to reorder · Right-click for more" FontSize="11" Foreground="{DynamicResource Muted}" Margin="3,0,0,7" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Everything in its place." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Content="＋ Add Application" Click="Add_Click" HorizontalAlignment="Left" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"/>
            <Button Grid.Column="1" Content="Manage folders" Click="Manage_Click"/>
          </Grid>
          <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" MaxHeight="44" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Accent}" Margin="3,8,3,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
      </Grid>
    </Border>
  </AdornerDecorator>
</Window>

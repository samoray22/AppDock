<Window x:Class="AppBox.App.Views.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AppBox.App.Controls" Title="AppDock" Width="468" Height="160" AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="Manual" AllowDrop="True" PreviewDragOver="Launcher_DragOver" PreviewDragLeave="Launcher_DragLeave" PreviewDrop="Launcher_Drop">
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Grid Margin="8">
    <controls:PopupChrome x:Name="Chrome" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Line}"><controls:PopupChrome.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/></controls:PopupChrome.Effect></controls:PopupChrome>
  <AdornerDecorator>
    <Border x:Name="Frame" Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="12" ContextMenuOpening="Container_ContextMenuOpening">
      <Border.ContextMenu><ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
        <MenuItem Header="Edit Container" Click="EditContainer_Click"/>
        <MenuItem Header="Add Application" Click="Add_Click"/>
        <MenuItem Header="Rename Container" Click="RenameContainer_Click"/>
        <MenuItem Header="Change Container Icon" Click="ChangeIcon_Click"/>
        <MenuItem Header="Container Settings" Click="Manage_Click"/>
        <MenuItem Header="Activate/Deactivate" Click="Activate_Click"/>
        <MenuItem Header="Manage Containers" Click="Manage_Click"/>
        <Separator/><MenuItem Header="Close" Click="Dismiss_Click"/>
      </ContextMenu></Border.ContextMenu>
      <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="AppScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="AppScroller_ScrollChanged">
          <Grid Height="{Binding ContentHeight}">
            <ItemsControl x:Name="AppGrid" ItemsSource="{Binding Applications}" Height="{Binding GridHeight}" Visibility="{Binding ShowApplications, Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
              <Button Width="90" Height="118" Margin="3,0" Padding="3" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Entry.Target}" AutomationProperties.Name="{Binding Name}" PreviewMouseLeftButtonDown="Tile_MouseDown" PreviewMouseMove="Tile_MouseMove" ContextMenuOpening="Tile_ContextMenuOpening">
                <Button.ContextMenu><ContextMenu Opened="Menu_Opened" Closed="Menu_Closed"><MenuItem Header="Open File Location" Click="Location_Click"/><MenuItem Header="Launch" Click="Launch_Click"/><MenuItem Header="Rename" Click="Rename_Click"/><Separator/><MenuItem Header="Remove From Container" Click="Remove_Click"/></ContextMenu></Button.ContextMenu>
                <StackPanel><controls:AppIcon Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6"/><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="82" HorizontalAlignment="Center" Visibility="{Binding ShowName, Converter={StaticResource BoolVisibility}}"/></StackPanel>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <ItemsControl ItemsSource="{Binding Containers}" Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="90" Height="118" Margin="3,0" Background="Transparent" BorderThickness="0" Click="Container_Click" PreviewMouseRightButtonDown="Container_RightClick" ToolTip="{Binding Folder.Name}"><StackPanel><Image Source="{Binding Icon}" Width="48" Height="48"/><TextBlock Text="{Binding Folder.Name}" TextTrimming="CharacterEllipsis" MaxWidth="82" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"><Button Content="Done" Command="{Binding ToggleEditCommand}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="44" Foreground="{DynamicResource Accent}"/></StackPanel>
        <Border Visibility="{Binding ExternalDropActive, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="12" IsHitTestVisible="False"><TextBlock Text="＋ Add applications" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
    </Border>
  </AdornerDecorator>
  </Grid>
</Window>

<Window x:Class="AppBox.App.Views.EdgeSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppDock Edge Sidebar"
        Width="16"
        Height="152"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowDrop="True"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.ContextMenu>
      <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.OpenAllContainers}" Click="AllContainers_Click">
          <MenuItem.Icon><TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.EditContainer}" Click="EditContainer_Click">
          <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.ManageContainers}" Click="ManageContainers_Click">
          <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.SwitchEdge}" Click="SwitchEdge_Click">
          <MenuItem.Icon><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.SwitchSidebarLayout}" Click="SwitchSidebarLayout_Click">
          <MenuItem.Icon><TextBlock Text="&#xE8A0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.SidebarSettings}" Click="Settings_Click">
          <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="{DynamicResource Str.Sidebar.Menu.HideSidebar}" Click="DisableSidebar_Click">
          <MenuItem.Icon><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
    </Grid.ContextMenu>

    <!-- Collapsed State: Subtle Screen-Edge Trigger Handle -->
    <Grid x:Name="HandleRoot"
          Background="#01000000"
          Cursor="Hand"
          ToolTip="{DynamicResource Str.Sidebar.StripTooltip}"
          MouseLeftButtonDown="Handle_MouseLeftButtonDown"
          MouseMove="Handle_MouseMove"
          MouseLeftButtonUp="Handle_MouseLeftButtonUp">
      <Border x:Name="HandlePill"
              Width="6"
              Height="136"
              CornerRadius="3.5"
              Background="{DynamicResource Accent}"
              BorderBrush="{DynamicResource Card}"
              BorderThickness="0.75"
              Opacity="0.55"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="2,8,2,8">
        <Border.Effect>
          <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.28"/>
        </Border.Effect>
      </Border>
    </Grid>

    <!-- Expanded State: Samsung One UI-style Vertical Edge Strip -->
    <Border x:Name="StripRoot"
            Visibility="Collapsed"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="26"
            Margin="5,6,5,6"
            Padding="5,10,5,10"
            RenderTransformOrigin="0.5,0.5">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.32"/>
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="StripTranslate" X="0" Y="0"/>
      </Border.RenderTransform>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Samsung Edge Panel Top Section: Recent / Running Apps + Dotted Divider -->
        <StackPanel x:Name="RecentAppsSection" Grid.Row="0" Visibility="Collapsed">
          <ItemsControl x:Name="SidebarRecentAppsList"
                        ItemsSource="{Binding SidebarRecentApps}"
                        Focusable="False"
                        MouseMove="SidebarList_MouseMove"
                        MouseLeave="SidebarList_MouseLeave">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="48"
                        Height="48"
                        Margin="2,2,2,2"
                        Padding="3"
                        Style="{StaticResource MacTileButton}"
                        ToolTip="{Binding Name}"
                        AutomationProperties.Name="{Binding Name}"
                        Click="RecentAppButton_Click">
                  <Grid Width="40" Height="42">
                    <Image Source="{Binding Icon}"
                           Width="32"
                           Height="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,2,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1.5" Opacity="0.22"/>
                      </Image.Effect>
                    </Image>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1">
                      <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Muted}" Margin="1,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"/>
                      <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Accent}" Margin="1,0" Visibility="{Binding IsLastLaunched, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Rectangle Height="1.5"
                     Stroke="{DynamicResource Muted}"
                     StrokeThickness="1.5"
                     StrokeDashArray="1 2.2"
                     Opacity="0.55"
                     Margin="6,5,6,5"
                     HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Single Mode: Main AppDock Launcher Icon -->
        <Button x:Name="SingleModeButton"
                Grid.Row="1"
                Width="52"
                Height="52"
                Margin="2,2,2,4"
                Style="{StaticResource MacTileButton}"
                ToolTip="{DynamicResource Str.Sidebar.SingleModeTooltip}"
                AutomationProperties.Name="AppDock All Containers"
                AllowDrop="True"
                Click="SingleModeButton_Click"
                MouseEnter="SingleModeButton_MouseEnter"
                PreviewDragOver="SingleModeButton_DragOver"
                PreviewDrop="SingleModeButton_Drop">
          <Image Source="pack://application:,,,/AppDock;component/Resources/Branding/AppDock64.png"
                 Width="38"
                 Height="38"
                 RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
              <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.22"/>
            </Image.Effect>
          </Image>
        </Button>

        <!-- Multiple Mode: Scrollable Vertical Stack of Active Containers -->
        <ScrollViewer x:Name="ContainersScroller"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="410"
                      Focusable="False">
          <StackPanel>
            <ItemsControl x:Name="SidebarContainersList"
                          ItemsSource="{Binding Containers}"
                          Focusable="False"
                          MouseMove="SidebarList_MouseMove"
                          MouseLeave="SidebarList_MouseLeave">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="52"
                          Height="52"
                          Margin="2,3,2,3"
                          Padding="4"
                          Style="{StaticResource MacTileButton}"
                          ToolTip="{Binding Folder.Name}"
                          AutomationProperties.Name="{Binding Folder.Name}"
                          AllowDrop="True"
                          Click="ContainerButton_Click"
                          MouseEnter="ContainerButton_MouseEnter"
                          MouseLeave="ContainerButton_MouseLeave"
                          PreviewMouseRightButtonDown="ContainerButton_RightClick"
                          PreviewDragOver="ContainerButton_DragOver"
                          PreviewDrop="ContainerButton_Drop">
                    <Grid Width="42" Height="42">
                      <Image Source="{Binding Icon}"
                             Width="38"
                             Height="38"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                          <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.22"/>
                        </Image.Effect>
                      </Image>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="EmptyContainersButton"
                    Width="48"
                    Height="48"
                    Margin="2,4,2,4"
                    Style="{StaticResource MacTileButton}"
                    ToolTip="{DynamicResource Str.Sidebar.EmptyContainersTooltip}"
                    Visibility="Collapsed"
                    Click="ManageContainers_Click">
              <TextBlock Text="＋" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Samsung Edge Panel Dotted Divider -->
        <Rectangle Grid.Row="3"
                   Height="1.5"
                   Stroke="{DynamicResource Muted}"
                   StrokeThickness="1.5"
                   StrokeDashArray="1 2.2"
                   Opacity="0.55"
                   Margin="6,7,6,6"
                   HorizontalAlignment="Stretch"/>

        <!-- Bottom Action Bar (All Containers ⋮⋮⋮ / Edit ✏ / Settings ⚙) -->
        <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
            <Button Width="26"
                    Height="24"
                    Padding="0"
                    Margin="1,0"
                    Style="{StaticResource MacHeaderPillButton}"
                    ToolTip="{DynamicResource Str.Sidebar.Menu.OpenAllContainers}"
                    AutomationProperties.Name="Open All Containers"
                    Click="AllContainers_Click">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Width="26"
                    Height="24"
                    Padding="0"
                    Margin="1,0"
                    Style="{StaticResource MacHeaderPillButton}"
                    ToolTip="{DynamicResource Str.Sidebar.Menu.EditContainer}"
                    AutomationProperties.Name="Edit Container"
                    Click="EditContainer_Click">
              <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
          <Button Width="54"
                  Height="24"
                  Padding="0"
                  Margin="0"
                  Style="{StaticResource MacHeaderPillButton}"
                  ToolTip="Sidebar Settings"
                  AutomationProperties.Name="Sidebar Settings"
                  Click="Settings_Click">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

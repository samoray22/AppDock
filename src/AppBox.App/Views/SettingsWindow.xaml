<Window x:Class="AppBox.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AppBox.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppDock Settings" Width="870" Height="650" MinWidth="740" MinHeight="540" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Resources><local:ContainerIconConverter x:Key="ContainerIcon"/></Window.Resources>
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,0,0,22"><TextBlock Text="APPDOCK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Make room for what matters." FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
    <TabControl x:Name="Sections" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource Surface}" BorderThickness="0" Foreground="{DynamicResource Ink}">
      <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="16,13" Margin="0,3,20,3" CornerRadius="8" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
      <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15,8,5,0">
        <TextBlock Text="General" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="A launcher that feels at home." Foreground="{DynamicResource Muted}" Margin="0,8,0,22"/>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="Taskbar Layout Mode" FontWeight="SemiBold"/><RadioButton x:Name="SingleMode" GroupName="Mode" Content="Single AppDock" Click="Mode_Click"/><RadioButton x:Name="MultipleMode" GroupName="Mode" Content="Multiple AppDocks" Click="Mode_Click"/><TextBlock Text="Multiple mode creates stable launcher shortcuts. Open Launcher Shortcuts and use Windows Pin to taskbar manually." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="4,5,0,0"/></StackPanel></Border>
        <CheckBox Content="Show application names" IsChecked="{Binding Config.Settings.ShowApplicationNames}" Click="Preference_Click"/>
        <TextBlock Text="Application icon size"/><Slider Minimum="24" Maximum="64" TickFrequency="8" IsSnapToTickEnabled="True" Value="{Binding Config.Settings.IconSize}" PreviewMouseLeftButtonUp="Preference_Click"/>

      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Containers"><Grid Margin="12,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Your containers" FontSize="23" FontWeight="SemiBold"/>
        <WrapPanel Grid.Row="1" Margin="0,12,0,8"><Button Content="New Container" Click="NewFolder_Click"/><Button Content="Rename" Click="Rename_Click"/><Button Content="Change Icon" Click="Icon_Click"/><Button Content="Activate/Deactivate" Click="Active_Click"/><Button Content="Edit Applications" Click="Edit_Click"/><Button Content="Delete Container" Click="Delete_Click"/></WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" AutomationProperties.Name="Containers"><ListBox.ItemTemplate><DataTemplate><StackPanel><Image Source="{Binding Icon, Converter={StaticResource ContainerIcon}}" Width="32" Height="32" HorizontalAlignment="Left"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Applications.Count, StringFormat={}{0} applications}"/><TextBlock Text="{Binding IsActive, StringFormat=Active: {0}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ListBox Grid.Column="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" AutomationProperties.Name="Applications"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button Content="＋ Browse files" Click="Browse_Click"/><Button Content="Start menu / installed" Click="Discover_Click"/></WrapPanel><WrapPanel><Button Content="Remove app" Click="Remove_Click"/><Button Content="↑ Move up" Click="Up_Click"/><Button Content="↓ Move down" Click="Down_Click"/></WrapPanel><TextBlock Text="Containers hold references. Your application files stay where they are." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,8,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Appearance"><StackPanel Margin="15,8"><TextBlock Text="Appearance" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Choose your light." Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/><CheckBox x:Name="FollowSystem" Content="Follow system light/dark theme" Click="Theme_Click"/><RadioButton x:Name="LightTheme" Content="Light" GroupName="Theme" Click="Theme_Click"/><RadioButton x:Name="DarkTheme" Content="Dark" GroupName="Theme" Click="Theme_Click"/></StackPanel></TabItem>
      <TabItem Header="Taskbar Interaction"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15,8"><TextBlock Text="Taskbar Interaction" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <TextBlock Text="Container opening behavior" FontSize="18" FontWeight="SemiBold"/>
        <RadioButton Content="Click" IsChecked="True" GroupName="Opening"/>
        <RadioButton Content="Hover (unavailable)" IsEnabled="False" GroupName="Opening"/>
        <RadioButton Content="Click or Hover (unavailable)" IsEnabled="False" GroupName="Opening"/>
        <TextBlock Text="Windows provides no validated hover-to-container identity for pinned launchers. Click opening remains active." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="4,4,4,12"/>
        <TextBlock Text="Hover opening delay (ms, unavailable)"/><Slider Minimum="100" Maximum="2000" Value="{Binding Config.Settings.HoverOpeningDelayMs}" IsEnabled="False"/>
        <TextBlock Text="Hover closing delay (ms, unavailable)"/><Slider Minimum="100" Maximum="2000" Value="{Binding Config.Settings.HoverClosingDelayMs}" IsEnabled="False"/>
        <CheckBox Content="Show popup pointer" IsChecked="{Binding Config.Settings.ShowPopupPointer}" Click="Preference_Click"/>
        <CheckBox Content="Enable popup animations" IsChecked="{Binding Config.Settings.EnableAnimations}" Click="Preference_Click"/>
        <TextBlock Text="Right-click a taskbar icon for AppDock Settings, Edit Container and Manage Containers where Windows displays application Jump List tasks." TextWrapping="Wrap" Margin="0,8,0,16"/>
<Button Content="Open Launcher Shortcuts" Click="Launchers_Click"/><TextBlock TextWrapping="Wrap" Text="Pin AppDock.exe using Windows’ standard Pin to taskbar command. Opening it again activates the running launcher. Dedicated containers use stable taskbar identities; Settings shares its popup owner."/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Text="AppDock has no validated exact pinned-button rectangle. The popup pointer uses the cursor position over a bottom taskbar, or the popup center otherwise. This is approximate alignment."/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{DynamicResource Muted}" Text="Use Open Launcher Shortcuts in Multiple mode, then Windows Pin to taskbar. Cached pin icons may require manual unpin/repin. No Explorer internals are modified."/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Startup"><StackPanel Margin="15,8"><TextBlock Text="Startup" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Ready when you are." Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/><CheckBox x:Name="StartWindows" Content="Start with Windows" Click="Startup_Click"/><TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Uses your Windows user account’s startup registration. AppDock starts quietly in the notification area. No administrator access is needed."/></StackPanel></TabItem>
      <TabItem Header="About"><StackPanel Margin="15,8"><TextBlock Text="AppDock" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Version 0.1.0 · Phase 2B" Foreground="{DynamicResource Accent}" Margin="0,10,0,24"/><TextBlock Text="Small containers. A calmer taskbar." FontSize="18"/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Text="A native Windows 11 launcher built with WPF and .NET 10. Your containers and preferences are stored locally in %LOCALAPPDATA%\AppDock\."/><TextBlock Margin="0,20,0,0" Foreground="{DynamicResource Muted}" Text="No account. No telemetry. No administrator privileges."/></StackPanel></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changes save automatically" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Done" IsCancel="True" Click="Done_Click"/></Grid>
  </Grid>
</Window>

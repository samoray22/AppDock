<Window x:Class="AppBox.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppBox Settings" Width="870" Height="650" MinWidth="740" MinHeight="540" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,0,0,22"><TextBlock Text="APPBOX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Make room for what matters." FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
    <TabControl x:Name="Sections" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource Surface}" BorderThickness="0" Foreground="{DynamicResource Ink}">
      <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="16,13" Margin="0,3,20,3" CornerRadius="8" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
      <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15,8,5,0">
        <TextBlock Text="General" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="A launcher that feels at home." Foreground="{DynamicResource Muted}" Margin="0,8,0,22"/>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="Taskbar Layout Mode" FontWeight="SemiBold"/><RadioButton x:Name="SingleMode" GroupName="Mode" Content="Single AppBox" Click="Mode_Click"/><RadioButton x:Name="MultipleMode" GroupName="Mode" Content="Multiple AppBoxes" Click="Mode_Click"/><TextBlock Text="Multiple mode accepts folder-specific activation. Independent taskbar pins are not available in Phase 1." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="4,5,0,0"/></StackPanel></Border>
        <CheckBox Content="Show application names" IsChecked="{Binding Config.Settings.ShowApplicationNames}" Click="Preference_Click"/>
        <CheckBox Content="Automatically close after launching" IsChecked="{Binding Config.Settings.CloseAfterLaunch}" Click="Preference_Click"/>
        <CheckBox Content="Enable animations" IsChecked="{Binding Config.Settings.EnableAnimations}" Click="Preference_Click"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Folders"><Grid Margin="12,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Your folders" FontSize="23" FontWeight="SemiBold"/>
        <WrapPanel Grid.Row="1" Margin="0,12,0,8"><Button Content="New folder" Click="NewFolder_Click"/><Button Content="Rename" Click="Rename_Click"/><Button Content="Delete folder" Click="Delete_Click"/></WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" AutomationProperties.Name="Folders"/>
          <ListBox Grid.Column="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" AutomationProperties.Name="Applications"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button Content="＋ Browse files" Click="Browse_Click"/><Button Content="Start menu / installed" Click="Discover_Click"/></WrapPanel><WrapPanel><Button Content="Remove app" Click="Remove_Click"/><Button Content="↑ Move up" Click="Up_Click"/><Button Content="↓ Move down" Click="Down_Click"/></WrapPanel><TextBlock Text="Folders hold references. Your application files stay where they are." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,8,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Appearance"><StackPanel Margin="15,8"><TextBlock Text="Appearance" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Choose your light." Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/><CheckBox x:Name="FollowSystem" Content="Follow system light/dark theme" Click="Theme_Click"/><RadioButton x:Name="LightTheme" Content="Light" GroupName="Theme" Click="Theme_Click"/><RadioButton x:Name="DarkTheme" Content="Dark" GroupName="Theme" Click="Theme_Click"/></StackPanel></TabItem>
      <TabItem Header="Taskbar"><StackPanel Margin="15,8"><TextBlock Text="Taskbar" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="One familiar place to find your apps." Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/><TextBlock TextWrapping="Wrap" Text="Pin AppBox.App.exe using Windows’ standard Pin to taskbar command. Opening it again activates the running launcher. The popup uses one standard AppBox taskbar identity; Settings shares its owner."/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Text="Windows does not expose a supported API to locate the exact pinned button. AppBox uses the pointer position when it is over the taskbar, otherwise the working-area edge of that monitor."/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{DynamicResource Muted}" Text="Independent folder pins require a future verified identity and shortcut design. No Explorer modifications or taskbar injection are used."/></StackPanel></TabItem>
      <TabItem Header="Startup"><StackPanel Margin="15,8"><TextBlock Text="Startup" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Ready when you are." Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/><CheckBox x:Name="StartWindows" Content="Start with Windows" Click="Startup_Click"/><TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Uses your Windows user account’s startup registration. AppBox starts quietly in the notification area. No administrator access is needed."/></StackPanel></TabItem>
      <TabItem Header="About"><StackPanel Margin="15,8"><TextBlock Text="AppBox" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Version 0.1.0 · Phase 1" Foreground="{DynamicResource Accent}" Margin="0,10,0,24"/><TextBlock Text="Small folders. A calmer taskbar." FontSize="18"/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Text="A native Windows 11 launcher built with WPF and .NET 10. Your folders and preferences are stored locally in %LOCALAPPDATA%\AppBox\."/><TextBlock Margin="0,20,0,0" Foreground="{DynamicResource Muted}" Text="No account. No telemetry. No administrator privileges."/></StackPanel></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changes save automatically" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Done" IsCancel="True" Click="Done_Click"/></Grid>
  </Grid>
</Window>

<Window x:Class="AppBox.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:AppBox.App.Controls" xmlns:local="clr-namespace:AppBox.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Str.Settings.Title}" Width="940" Height="740" MinWidth="740" MinHeight="540" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Resources><local:ContainerIconConverter x:Key="ContainerIcon"/></Window.Resources>
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="8,0,0,12"><Image Source="pack://application:,,,/AppDock;component/Resources/Branding/AppDock64.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{DynamicResource Str.Settings.Header}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
    <TabControl x:Name="Sections" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}">
      <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="12,10" Margin="0,2,12,2" CornerRadius="6" Background="Transparent" Width="172"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
      <TabItem Header="{DynamicResource Str.Settings.Tab.General}" Tag="&#xE713;"><ScrollViewer x:Name="GeneralScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="{DynamicResource Card}" Padding="18" CornerRadius="8"><StackPanel x:Name="GeneralContent">
        <TextBlock Text="{DynamicResource Str.General.SurfacesHeading}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Str.General.SurfacesDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <RadioButton x:Name="TaskbarOnlyRadio" GroupName="ActiveSurface" IsChecked="{Binding IsTaskbarOnlyActive, Mode=TwoWay}" VerticalContentAlignment="Top">
              <StackPanel Margin="4,0,0,0">
                <TextBlock Text="{DynamicResource Str.General.Surface.TaskbarOnly.Title}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{DynamicResource Str.General.Surface.TaskbarOnly.Desc}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </RadioButton>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <RadioButton x:Name="SidebarOnlyRadio" GroupName="ActiveSurface" IsChecked="{Binding IsSidebarOnlyActive, Mode=TwoWay}" VerticalContentAlignment="Top">
              <StackPanel Margin="4,0,0,0">
                <TextBlock Text="{DynamicResource Str.General.Surface.SidebarOnly.Title}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{DynamicResource Str.General.Surface.SidebarOnly.Desc}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </RadioButton>
          </Border>
          <Border Grid.Column="4" Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <RadioButton x:Name="BothSurfacesRadio" GroupName="ActiveSurface" IsChecked="{Binding IsBothSurfacesActive, Mode=TwoWay}" VerticalContentAlignment="Top">
              <StackPanel Margin="4,0,0,0">
                <TextBlock Text="{DynamicResource Str.General.Surface.Both.Title}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{DynamicResource Str.General.Surface.Both.Desc}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </RadioButton>
          </Border>
        </Grid>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,12"/>
        <TextBlock Text="{DynamicResource Str.General.TaskbarLayoutHeading}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Str.General.TaskbarLayoutDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <Grid x:Name="LayoutCards"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <controls:LayoutSelectionCard x:Name="SingleMode" GroupName="LayoutMode" Title="{DynamicResource Str.General.Layout.Single.Title}" Description="{DynamicResource Str.General.Layout.Single.Desc}" IsChecked="{Binding IsSingleLayout, Mode=TwoWay}" AutomationProperties.Name="Single AppDock"/>
          <controls:LayoutSelectionCard x:Name="MultipleMode" Grid.Column="2" GroupName="LayoutMode" Title="{DynamicResource Str.General.Layout.Multiple.Title}" Multiple="True" Description="{DynamicResource Str.General.Layout.Multiple.Desc}" IsChecked="{Binding IsMultipleLayout, Mode=TwoWay}" AutomationProperties.Name="Multiple AppDocks"/>
        </Grid>
        <TextBlock Text="{DynamicResource Str.General.LayoutTip}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,12"/>
        <TextBlock Text="{DynamicResource Str.General.LanguageHeading}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource Str.General.LanguageDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ComboBox x:Name="LanguageComboBox" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" DisplayMemberPath="DisplayName" Width="320" HorizontalAlignment="Left" FontSize="13" Padding="8,5" Margin="0,0,0,4"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,12"/>
        <TextBlock Text="{DynamicResource Str.General.OtherOptionsHeading}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <controls:AppDockToggleSwitch x:Name="StartupToggle" Content="{DynamicResource Str.General.StartWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start AppDock with Windows"/>
        <controls:AppDockToggleSwitch x:Name="NamesToggle" Content="{DynamicResource Str.General.ShowAppNames}" IsChecked="{Binding ShowAppNames, Mode=TwoWay}" AutomationProperties.Name="Show app names"/>
        <controls:AppDockToggleSwitch x:Name="ShortenNamesToggle" Content="{DynamicResource Str.General.ShortenAppNames}" IsChecked="{Binding ShortenAppNames, Mode=TwoWay}" AutomationProperties.Name="Shorten application names"/>
        <controls:AppDockToggleSwitch x:Name="AutoCloseToggle" Content="{DynamicResource Str.General.AutoCloseAfterLaunch}" IsChecked="{Binding AutoCloseAfterLaunch, Mode=TwoWay}" AutomationProperties.Name="Auto close after launching an app"/>
        <controls:AppDockToggleSwitch x:Name="StyleToggle" IsEnabled="{Binding Windows11StyleAvailable}" IsChecked="{Binding UseWindows11Style, Mode=TwoWay}" AutomationProperties.Name="Use Windows 11 style"><TextBlock Text="{DynamicResource Str.General.UseWindows11Style}" TextWrapping="Wrap"/></controls:AppDockToggleSwitch>
        <controls:AppDockToggleSwitch x:Name="ContainerBorderToggle" Content="{DynamicResource Str.General.ShowContainerBorder}" IsChecked="{Binding ShowContainerBorder, Mode=TwoWay}" AutomationProperties.Name="Show container window border"/>
        <controls:AppDockToggleSwitch x:Name="CommandLineShellsToggle" Content="{DynamicResource Str.General.AllowCommandLineShells}" IsChecked="{Binding AllowCommandLineShells, Mode=TwoWay}" AutomationProperties.Name="Allow command-line shells"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,10"/>
        <TextBlock Text="{DynamicResource Str.General.BackupHeading}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource Str.General.BackupDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,4">
          <Button x:Name="ExportBackupButton" Content="{DynamicResource Str.General.ExportBackup}" Click="ExportBackup_Click" Margin="0,0,8,0"/>
          <Button x:Name="ImportBackupButton" Content="{DynamicResource Str.General.ImportBackup}" Click="ImportBackup_Click"/>
        </WrapPanel>
        <TextBlock x:Name="StyleFeedback" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="1,5,0,0"/>
        <TextBlock Text="{Binding PreferenceError}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PreferenceError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource Str.Settings.Tab.Containers}" Tag="&#xE8B7;"><Grid Margin="10,2,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12.5"/>
          </Style>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,1"/>
          </Style>
        </Grid.Resources>
        <TextBlock Text="{DynamicResource Str.Containers.Heading}" FontSize="19" FontWeight="SemiBold"/>
        <WrapPanel Grid.Row="1" Margin="0,6,0,6"><Button Content="{DynamicResource Str.Containers.NewContainer}" Click="NewFolder_Click"/><Button Content="{DynamicResource Str.Containers.Rename}" Click="Rename_Click"/><Button Content="{DynamicResource Str.Containers.ChangeIcon}" Click="Icon_Click"/><Button Content="{DynamicResource Str.Containers.Active}" Click="Active_Click"/><Button Content="{DynamicResource Str.Containers.MoveUp}" Click="FolderUp_Click" IsEnabled="{Binding CanMoveFolderUp}" ToolTip="{DynamicResource Str.Containers.MoveUpTooltip}"/><Button Content="{DynamicResource Str.Containers.MoveDown}" Click="FolderDown_Click" IsEnabled="{Binding CanMoveFolderDown}" ToolTip="{DynamicResource Str.Containers.MoveDownTooltip}"/><Button Content="{DynamicResource Str.Containers.PinToTaskbar}" Click="PinTaskbar_Click"/><Button Content="{DynamicResource Str.Containers.EditApplications}" Click="Edit_Click"/><Button Content="{DynamicResource Str.Containers.DeleteContainer}" Click="Delete_Click"/></WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ListBox x:Name="FoldersList" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" AllowDrop="True" PreviewMouseLeftButtonDown="FoldersList_PreviewMouseLeftButtonDown" PreviewMouseMove="FoldersList_PreviewMouseMove" DragOver="FoldersList_DragOver" Drop="FoldersList_Drop" ToolTip="{DynamicResource Str.Containers.ContainersTooltip}" AutomationProperties.Name="Containers">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="2,1">
                  <Image Source="{Binding Icon, Converter={StaticResource ContainerIcon}}" Width="26" Height="26" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="9,0,0,0" MaxWidth="135"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox x:Name="ApplicationsList" Grid.Column="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" AutomationProperties.Name="Applications">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Width="28" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IndexBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Target}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Margin="0,1,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,6,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedFolder}">
              <TextBlock Text="{DynamicResource Str.Containers.Sort}" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox x:Name="ContainerSortOverrideBox" SelectedIndex="{Binding SelectedFolderSortOverrideIndex, Mode=TwoWay}" Width="118" FontSize="11.5" Padding="6,2" Margin="0,0,8,0" ToolTip="{DynamicResource Str.Containers.SortTooltip}">
                <ComboBoxItem Content="{DynamicResource Str.Containers.Sort.GlobalDefault}"/>
                <ComboBoxItem Content="{DynamicResource Str.Containers.Sort.ManualOrder}"/>
                <ComboBoxItem Content="{DynamicResource Str.Containers.Sort.RecentlyUsed}"/>
              </ComboBox>
              <TextBlock Text="{DynamicResource Str.Containers.Cols}" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox x:Name="ContainerColsOverrideBox" SelectedIndex="{Binding SelectedFolderColumnsOverrideIndex, Mode=TwoWay}" Width="72" FontSize="11.5" Padding="6,2" Margin="0,0,8,0" ToolTip="{DynamicResource Str.Containers.ColsTooltip}">
                <ComboBoxItem Content="{DynamicResource Str.Containers.Cols.Global}"/>
                <ComboBoxItem Content="2 cols"/>
                <ComboBoxItem Content="3 cols"/>
                <ComboBoxItem Content="4 cols"/>
                <ComboBoxItem Content="5 cols"/>
                <ComboBoxItem Content="6 cols"/>
                <ComboBoxItem Content="7 cols"/>
                <ComboBoxItem Content="8 cols"/>
              </ComboBox>
              <TextBlock Text="{DynamicResource Str.Containers.Rows}" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox x:Name="ContainerRowsOverrideBox" SelectedIndex="{Binding SelectedFolderRowsOverrideIndex, Mode=TwoWay}" Width="72" FontSize="11.5" Padding="6,2" ToolTip="{DynamicResource Str.Containers.RowsTooltip}">
                <ComboBoxItem Content="{DynamicResource Str.Containers.Rows.Global}"/>
                <ComboBoxItem Content="1 row"/>
                <ComboBoxItem Content="2 rows"/>
                <ComboBoxItem Content="3 rows"/>
                <ComboBoxItem Content="4 rows"/>
                <ComboBoxItem Content="5 rows"/>
                <ComboBoxItem Content="6 rows"/>
                <ComboBoxItem Content="7 rows"/>
                <ComboBoxItem Content="8 rows"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Apps: " Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="{Binding SelectedContainerAppsText}" FontWeight="Bold" FontSize="12" Margin="0,0,12,0"/>
              <TextBlock Text="{DynamicResource Str.Containers.Status.Label}" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="{Binding SelectedContainerStatusText}" FontWeight="Bold" FontSize="12">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{DynamicResource StatusInactive}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelectedContainerActive}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource StatusActive}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{DynamicResource Str.Containers.ContainerPos.Label}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,0,0,0"/>
              <TextBlock Text="{Binding SelectedContainerPositionText}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentText}"/>
              <TextBlock Text="{DynamicResource Str.Containers.AppPos.Label}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,0,0,0"/>
              <TextBlock Text="{Binding SelectedAppPositionText}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentText}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <WrapPanel Grid.Row="4" Margin="0,6,0,0">
          <Button Content="{DynamicResource Str.Containers.BrowseFiles}" Click="Browse_Click"/>
          <Button Content="{DynamicResource Str.Containers.StartMenuInstalled}" Click="Discover_Click" Margin="2,2,10,2"/>
          <Button Content="{DynamicResource Str.Containers.RemoveApp}" Click="Remove_Click" IsEnabled="{Binding HasSelectedApplication}" ToolTip="{DynamicResource Str.Containers.RemoveAppTooltip}"/>
          <Button Content="{DynamicResource Str.Containers.MoveAppTop}" Click="Top_Click" IsEnabled="{Binding CanMoveUp}" ToolTip="{DynamicResource Str.Containers.MoveAppTopTooltip}"/>
          <Button Content="{DynamicResource Str.Containers.MoveAppUp}" Click="Up_Click" IsEnabled="{Binding CanMoveUp}" ToolTip="{DynamicResource Str.Containers.MoveAppUpTooltip}"/>
          <Button Content="{DynamicResource Str.Containers.MoveAppDown}" Click="Down_Click" IsEnabled="{Binding CanMoveDown}" ToolTip="{DynamicResource Str.Containers.MoveAppDownTooltip}"/>
          <Button Content="{DynamicResource Str.Containers.MoveAppBottom}" Click="Bottom_Click" IsEnabled="{Binding CanMoveDown}" ToolTip="{DynamicResource Str.Containers.MoveAppBottomTooltip}"/>
        </WrapPanel>
      </Grid></TabItem>
      <TabItem Header="{DynamicResource Str.Settings.Tab.Appearance}" Tag="&#xE790;"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="15,8">
        <TextBlock Text="{DynamicResource Str.Appearance.Heading}" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Str.Appearance.ThemeSubtitle}" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/>
        <CheckBox x:Name="FollowSystem" Content="{DynamicResource Str.Appearance.FollowSystem}" Click="Theme_Click" Margin="0,0,0,10"/>
        <RadioButton x:Name="LightTheme" Content="{DynamicResource Str.Appearance.Light}" GroupName="Theme" Click="Theme_Click" Margin="0,0,0,8"/>
        <RadioButton x:Name="DarkTheme" Content="{DynamicResource Str.Appearance.Dark}" GroupName="Theme" Click="Theme_Click" Margin="0,0,0,22"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,20"/>

        <TextBlock Text="{DynamicResource Str.Appearance.AnimationsHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource Str.Appearance.AnimationsDescription}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <controls:AppDockToggleSwitch x:Name="AnimationsEnableToggle" Content="{DynamicResource Str.Appearance.EnableAnimations}" IsChecked="{Binding EnableAnimations, Mode=TwoWay}" AutomationProperties.Name="Enable container animations"/>
        <Grid Margin="0,8,0,12" IsEnabled="{Binding EnableAnimations}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <RadioButton x:Name="GenieAnimationRadio" GroupName="ContainerAnimationStyle" IsChecked="{Binding IsGenieAnimation, Mode=TwoWay}" Click="AnimationStyle_Click" VerticalContentAlignment="Top">
              <StackPanel Margin="4,0,0,0">
                <TextBlock Text="{DynamicResource Str.Animation.Genie.Title}" FontWeight="SemiBold" FontSize="13.5"/>
                <TextBlock Text="{DynamicResource Str.Animation.Genie.Description}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </RadioButton>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <RadioButton x:Name="SuckAnimationRadio" GroupName="ContainerAnimationStyle" IsChecked="{Binding IsSuckAnimation, Mode=TwoWay}" Click="AnimationStyle_Click" VerticalContentAlignment="Top">
              <StackPanel Margin="4,0,0,0">

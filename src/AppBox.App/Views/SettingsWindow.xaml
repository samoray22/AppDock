          <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0" Tag="#E74856" Click="HandleColorSwatch_Click" ToolTip="Coral Red (#E74856)"><Border Width="18" Height="18" CornerRadius="9" Background="#E74856"/></Button>
          <Button Width="26" Height="26" Padding="0" Margin="0,0,10,0" Tag="#E2E8F0" Click="HandleColorSwatch_Click" ToolTip="Silver White (#E2E8F0)"><Border Width="18" Height="18" CornerRadius="9" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1"/></Button>
          <TextBlock Text="{DynamicResource Str.Sidebar.HexLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
          <TextBox x:Name="HandleCustomColorBox" Width="90" VerticalContentAlignment="Center" Text="{Binding SidebarHandleCustomColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Padding="6,3"/>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,2,0,12"/>
        <TextBlock Text="{DynamicResource Str.Sidebar.TimingHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource Str.Sidebar.TimingDescription}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"/>
        <RadioButton x:Name="SidebarClickRadio" Content="{DynamicResource Str.Taskbar.Opening.Click}" IsChecked="{Binding IsSidebarClickOpen, Mode=TwoWay}" GroupName="SidebarOpening" Margin="4,4"/>
        <RadioButton x:Name="SidebarHoverRadio" Content="{DynamicResource Str.Taskbar.Opening.Hover}" IsChecked="{Binding IsSidebarHoverOpen, Mode=TwoWay}" GroupName="SidebarOpening" Margin="4,4"/>
        <RadioButton x:Name="SidebarClickOrHoverRadio" Content="{DynamicResource Str.Taskbar.Opening.ClickOrHover}" IsChecked="{Binding IsSidebarClickOrHoverOpen, Mode=TwoWay}" GroupName="SidebarOpening" Margin="4,4,4,12"/>
        <DockPanel Margin="0,4,0,2"><TextBlock Text="{DynamicResource Str.Taskbar.HoverOpenDelay}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="{Binding HoverOpeningDelayMs}" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="HoverOpenDelaySlider" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding HoverOpeningDelayMs, Mode=TwoWay}" Margin="0,2,0,12"/>
        <DockPanel Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Taskbar.HoverCloseDelay}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="{Binding HoverClosingDelayMs}" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="HoverCloseDelaySlider" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding HoverClosingDelayMs, Mode=TwoWay}" Margin="0,2,0,4"/>
      </StackPanel></Border></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource Str.Settings.Tab.Portable}" Tag="&#xE7B8;">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Background="{DynamicResource Card}" Padding="18" CornerRadius="8">
            <StackPanel>
              <TextBlock Text="{DynamicResource Str.Portable.Heading}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Text="{DynamicResource Str.Portable.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
              <controls:AppDockToggleSwitch x:Name="PortableModeToggle" IsChecked="{Binding IsPortableMode, Mode=OneWay}" Click="PortableModeToggle_Click" AutomationProperties.Name="Enable Portable Mode">
                <TextBlock Text="{DynamicResource Str.Portable.ToggleLabel}" TextWrapping="Wrap"/>
              </controls:AppDockToggleSwitch>
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,14"/>
              <TextBlock Text="{DynamicResource Str.Portable.StatusHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Border Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                  <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Str.Portable.ActiveModeLabel}" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                    <TextBlock Text="{Binding ActiveStorageModeText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" FontSize="12.5"/>
                  </WrapPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.Portable.ActivePathLabel}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveStorageDirectory}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.Portable.PortablePathLabel}" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding PortableStorageDirectory}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                  </Grid>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.Portable.AppDataPathLabel}" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding AppDataStorageDirectory}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                  </Grid>
                  <WrapPanel>
                    <Button x:Name="OpenActiveDataFolderButton" Content="{DynamicResource Str.Portable.OpenDataFolder}" Click="OpenDataFolder_Click" Margin="0,0,8,0"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{DynamicResource Str.Portable.HowItWorksHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Border Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Str.Portable.HowItWorks.PortableDesc}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                  <TextBlock Text="{DynamicResource Str.Portable.HowItWorks.AppDataDesc}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                  <TextBlock Text="{DynamicResource Str.Portable.HowItWorks.RisksDesc}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Str.Settings.Tab.Help}" Tag="&#xE897;">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,6,12,12">
            <TextBlock Text="{DynamicResource Str.Help.Heading}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Str.Help.Description}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,14"/>

            <!-- Pinning & Unpinning Containers Card (Most Important) -->
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str.Help.ModesCard.Heading}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Str.Help.ModesCard.Subtitle}" Foreground="{DynamicResource Ink}" FontWeight="Medium" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.ModesCard.Step1.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.ModesCard.Step1.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.ModesCard.Step2.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.ModesCard.Step2.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.ModesCard.Step3.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.ModesCard.Step3.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.ModesCard.Step4.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.ModesCard.Step4.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.ModesCard.Step5.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.ModesCard.Step5.Desc}" TextWrapping="Wrap"/></Grid>
              </StackPanel>
            </Border>

            <!-- Indicator Dots Card -->
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str.Help.DotsCard.Heading}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Str.Help.DotsCard.Subtitle}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid Margin="2,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="155"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.DotsCard.Dot1.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{DynamicResource Str.Help.DotsCard.Dot1.Desc}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="2,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="155"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.DotsCard.Dot2.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{DynamicResource Str.Help.DotsCard.Dot2.Desc}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{DynamicResource Str.Help.DotsCard.Tip}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="2,4,0,0"/>
              </StackPanel>
            </Border>

            <!-- Mouse & Click Shortcuts Card -->
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str.Help.MouseCard.Heading}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.MouseCard.LeftClick.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.MouseCard.LeftClick.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.MouseCard.MiddleClick.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.MouseCard.MiddleClick.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.MouseCard.ShiftClick.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.MouseCard.ShiftClick.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.MouseCard.CtrlShiftClick.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.MouseCard.CtrlShiftClick.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.MouseCard.RightClick.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.MouseCard.RightClick.Desc}" TextWrapping="Wrap"/></Grid>
              </StackPanel>
            </Border>

            <!-- Keyboard & Search Card -->
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str.Help.KeyboardCard.Heading}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.KeyboardCard.Typing.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.KeyboardCard.Typing.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.KeyboardCard.Numbers.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.KeyboardCard.Numbers.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.KeyboardCard.Arrows.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.KeyboardCard.Arrows.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.KeyboardCard.Backspace.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.KeyboardCard.Backspace.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.KeyboardCard.Esc.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.KeyboardCard.Esc.Desc}" TextWrapping="Wrap"/></Grid>
              </StackPanel>
            </Border>

            <!-- Drag, Drop & Editing Card -->
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str.Help.EditCard.Heading}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.EditCard.HoverHeader.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.EditCard.HoverHeader.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.EditCard.DragOut.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.EditCard.DragOut.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.EditCard.DropFiles.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.EditCard.DropFiles.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.EditCard.EditMode.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.EditCard.EditMode.Desc}" TextWrapping="Wrap"/></Grid>
              </StackPanel>
            </Border>

            <!-- Visual & Taskbar Features Card -->
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,14">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str.Help.FeaturesCard.Heading}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.FeaturesCard.Tint.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.FeaturesCard.Tint.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.FeaturesCard.Shorten.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.FeaturesCard.Shorten.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.FeaturesCard.Layouts.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.FeaturesCard.Layouts.Desc}" TextWrapping="Wrap"/></Grid>
                <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Help.FeaturesCard.Tray.Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource Str.Help.FeaturesCard.Tray.Desc}" TextWrapping="Wrap"/></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Str.Settings.Tab.About}" Tag="&#xE946;"><DockPanel Margin="15,8"><TextBlock DockPanel.Dock="Bottom" Margin="0,16,0,4" Foreground="{DynamicResource Muted}" Text="{DynamicResource Str.About.DevelopedBy}"/><StackPanel><Image Source="pack://application:,,,/AppDock;component/Resources/Branding/AppDock128.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock Text="AppDock" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding AppVersionText, FallbackValue='Version 3.0.0'}" Foreground="{DynamicResource Accent}" Margin="0,10,0,24"/><TextBlock Text="{DynamicResource Str.About.Tagline}" FontSize="18"/><TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Text="{DynamicResource Str.About.Description}"/><TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Muted}" Text="{DynamicResource Str.About.Privacy}"/></StackPanel></DockPanel></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Str.Common.ChangesSavedAuto}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource Str.Common.Done}" IsCancel="True" Click="Done_Click"/></Grid>
  </Grid>

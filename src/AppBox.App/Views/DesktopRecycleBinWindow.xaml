<Window x:Class="AppBox.App.Views.DesktopRecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppDock Recycle Bin"
        Width="64"
        Height="64"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource Ink}"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewDragOver="Window_DragOver"
        PreviewDrop="Window_Drop">
  <Grid x:Name="RootContent" Background="Transparent">
    <Grid.ContextMenu>
      <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
        <MenuItem Header="{DynamicResource Str.Launcher.Menu.Launch}" Click="OpenBin_Click">
          <MenuItem.Icon><TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="EmptyBinMenuItem" Header="Empty Recycle Bin" Click="EmptyBin_Click">
          <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem x:Name="ToggleLockPositionMenuItem" Header="{DynamicResource Str.Desktop.Menu.LockPosition}" Click="ToggleLockPosition_Click">
          <MenuItem.Icon><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Desktop.ResetPosition}" Click="ResetPositions_Click">
          <MenuItem.Icon><TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Str.Desktop.Menu.DesktopSettings}" Click="DesktopSettings_Click">
          <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
    </Grid.ContextMenu>

    <Border x:Name="BinBadge"
            Width="56"
            Height="56"
            Background="#01000000"
            BorderBrush="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="BinBadge_MouseLeftButtonDown"
            MouseMove="BinBadge_MouseMove"
            MouseLeftButtonUp="BinBadge_MouseLeftButtonUp">
      <Border.RenderTransform>
        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
      </Border.RenderTransform>
      <Image x:Name="RecycleBinImage"
             Width="46"
             Height="46"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Effect>
          <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/>
        </Image.Effect>
      </Image>
    </Border>
  </Grid>
</Window>

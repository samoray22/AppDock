<Window x:Class="AppBox.App.Views.DesktopContainersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AppBox.App.Controls"
        Title="AppDock Desktop Containers"
        Width="320"
        Height="220"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
  <Window.Style><StaticResource ResourceKey="AppWindow"/></Window.Style>
  <Grid x:Name="WindowStage">
    <Grid x:Name="RootContent" Background="Transparent">
      <Grid.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
          <MenuItem Header="{DynamicResource Str.Desktop.Menu.SwitchDisplayStyle}" Click="SwitchStyle_Click">
            <MenuItem.Icon><TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ToggleDesktopIconsMenuItem" Header="{DynamicResource Str.Desktop.Menu.HideDesktopIcons}" Click="ToggleDesktopIcons_Click">
            <MenuItem.Icon><TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ToggleLockPositionMenuItem" Header="{DynamicResource Str.Desktop.Menu.LockPosition}" Click="ToggleLockPosition_Click">
            <MenuItem.Icon><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{DynamicResource Str.Desktop.Menu.DesktopSettings}" Click="DesktopSettings_Click">
            <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <Separator/>
          <MenuItem Header="{DynamicResource Str.Desktop.Menu.HideDesktopContainers}" Click="DisableDesktopContainers_Click">
            <MenuItem.Icon><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </Grid.ContextMenu>

      <!-- Mode 1: Compact Desktop Dock (Opens 3-D Warp Flyout on Click / Hover) -->
      <Border x:Name="CompactRoot"
              Visibility="Visible"
              Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource Line}"
              BorderThickness="1"
              CornerRadius="22"
              Margin="8"
              Padding="8,10,8,10"
              MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
              MouseMove="DragSurface_MouseMove"
              MouseLeftButtonUp="DragSurface_MouseLeftButtonUp">
        <Border.Effect>
          <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.32"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
          <!-- Subtle drag handle bar at top of compact desktop dock -->
          <Border x:Name="CompactDragGrip"
                  Width="32"
                  Height="4"
                  CornerRadius="2"
                  Background="{DynamicResource Muted}"
                  Opacity="0.45"
                  Margin="0,0,0,6"
                  Cursor="SizeAll"
                  ToolTip="{DynamicResource Str.Sidebar.DragRepositionTip}"/>

          <ItemsControl x:Name="CompactContainersList"
                        ItemsSource="{Binding DesktopContainers}"
                        Focusable="False"
                        MouseMove="CompactList_MouseMove"
                        MouseLeave="CompactList_MouseLeave">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" MaxWidth="360" HorizontalAlignment="Center"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="76"
                        Height="84"
                        Margin="4"
                        Padding="4"
                        Style="{StaticResource MacTileButton}"
                        ToolTip="{Binding Folder.Name}"
                        AutomationProperties.Name="{Binding Folder.Name}"
                        AllowDrop="True"
                        Click="CompactContainer_Click"
                        MouseEnter="CompactContainer_MouseEnter"
                        MouseLeave="CompactContainer_MouseLeave"
                        PreviewDragOver="ContainerBox_DragOver"
                        PreviewDrop="ContainerBox_Drop">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}"
                           Width="40"
                           Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.24"/>
                      </Image.Effect>
                    </Image>
                    <TextBlock Text="{Binding Folder.Name}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="68"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CountText}"
                               FontSize="9.5"
                               Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button x:Name="CompactEmptyButton"
                  Visibility="Collapsed"
                  Padding="12,8"
                  Margin="4"
                  Style="{StaticResource MacTileButton}"
                  Click="DesktopSettings_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="＋" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Str.Desktop.EmptyHint}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Mode 2: Expanded Desktop Boxes (Fences / Desktop Widgets Style) -->
      <ScrollViewer x:Name="ExpandedRoot"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    MaxHeight="760"
                    Padding="4">
        <StackPanel>
          <ItemsControl x:Name="ExpandedContainersList"
                        ItemsSource="{Binding DesktopContainers}"
                        Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Margin="6"
                        Padding="10,8"
                        Width="316"
                        AllowDrop="True"
                        PreviewDragOver="ContainerBox_DragOver"
                        PreviewDrop="ContainerBox_Drop">
                  <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.28"/>
                  </Border.Effect>
                  <StackPanel>
                    <!-- Box Header Bar (Draggable) -->
                    <DockPanel Background="Transparent"
                               Cursor="SizeAll"
                               MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
                               MouseMove="DragSurface_MouseMove"
                               MouseLeftButtonUp="DragSurface_MouseLeftButtonUp">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↗"
                                Width="24"
                                Height="22"
                                Padding="0"
                                Margin="2,0"
                                Style="{StaticResource MacHeaderPillButton}"
                                ToolTip="{DynamicResource Str.Desktop.SwitchStyleTooltip}"
                                Click="OpenBoxInFlyout_Click"/>
                        <Button Content="{Binding CollapseGlyph}"
                                Width="24"
                                Height="22"
                                Padding="0"
                                Margin="2,0,0,0"
                                Style="{StaticResource MacHeaderPillButton}"
                                ToolTip="{DynamicResource Str.Desktop.CollapseExpandTooltip}"
                                Click="ToggleBoxCollapse_Click"/>
                      </StackPanel>
                      <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock Text="{Binding Folder.Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                      <Border Background="{DynamicResource Hover}" CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                      </Border>
                    </DockPanel>

                    <!-- Expanded App Grid -->
                    <Grid Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0">
                      <TextBlock Text="{DynamicResource Str.Launcher.EmptyContainer}"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
                                 Foreground="{DynamicResource Muted}"
                                 FontSize="11.5"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="8,12"/>
                      <ItemsControl ItemsSource="{Binding Applications}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Width="68"
                                    Height="76"
                                    Margin="3"
                                    Padding="3"
                                    Style="{StaticResource MacTileButton}"
                                    ToolTip="{Binding Name}"
                                    AutomationProperties.Name="{Binding Name}"
                                    Click="DesktopAppTile_Click"
                                    MouseMove="DesktopAppTile_MouseMove"
                                    MouseLeave="DesktopAppTile_MouseLeave">
                              <Button.ContextMenu>
                                <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                  <MenuItem Header="{DynamicResource Str.Launcher.Menu.Launch}" Click="DesktopAppMenuLaunch_Click"/>
                                  <MenuItem Header="{DynamicResource Str.Launcher.Menu.OpenFileLocation}" Click="DesktopAppMenuLocation_Click"/>
                                </ContextMenu>
                              </Button.ContextMenu>
                              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="62">
                                <Grid HorizontalAlignment="Center" Margin="0,1,0,2">
                                  <controls:AppIcon Width="36" Height="36">
                                    <controls:AppIcon.Effect>
                                      <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.22"/>
                                    </controls:AppIcon.Effect>
                                  </controls:AppIcon>
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3">
                                    <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Accent}" Margin="1,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"/>
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Muted}" Margin="1,0" Visibility="{Binding IsLastLaunched, Converter={StaticResource BoolVisibility}}"/>
                                  </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Label}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           MaxHeight="28"
                                           MaxWidth="60"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding ShowName, Converter={StaticResource BoolVisibility}}"/>
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border x:Name="ExpandedEmptyCard"
                  Visibility="Collapsed"
                  Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  CornerRadius="16"
                  Margin="6"
                  Padding="16,14"
                  Width="300">
            <Button Style="{StaticResource MacTileButton}" Padding="10,8" Click="DesktopSettings_Click">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="＋" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str.Desktop.EmptyHint}" FontSize="12.5" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 3-D Mesh Warp Viewport for Desktop Box Transitions -->
    <Viewport3D x:Name="DesktopWarpViewport" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="False">
      <Viewport3D.Camera>
        <PerspectiveCamera x:Name="DesktopWarpCamera" Position="160,110,480" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45" NearPlaneDistance="1" FarPlaneDistance="4000"/>
      </Viewport3D.Camera>
      <ModelVisual3D>
        <ModelVisual3D.Content>
          <Model3DGroup>
            <AmbientLight Color="White"/>
            <GeometryModel3D x:Name="DesktopWarpGeometryModel">
              <GeometryModel3D.Geometry>
                <MeshGeometry3D x:Name="DesktopWarpMesh"/>
              </GeometryModel3D.Geometry>
            </GeometryModel3D>
          </Model3DGroup>
        </ModelVisual3D.Content>
      </ModelVisual3D>
    </Viewport3D>
  </Grid>
</Window>

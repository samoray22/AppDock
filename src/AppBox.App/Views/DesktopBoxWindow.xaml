<Window x:Class="AppBox.App.Views.DesktopBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AppBox.App.Controls"
        Title="AppDock Desktop Container"
        Width="64"
        Height="64"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource Ink}"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewDragOver="Window_DragOver"
        PreviewDrop="Window_Drop">
  <Grid x:Name="WindowStage" Background="Transparent">
    <Grid x:Name="RootContent" Background="Transparent">
      <Grid.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
          <MenuItem Header="{DynamicResource Str.Desktop.Menu.SwitchDisplayStyle}" Click="SwitchStyle_Click">
            <MenuItem.Icon><TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ToggleDesktopIconsMenuItem" Header="{DynamicResource Str.Desktop.Menu.HideDesktopIcons}" Click="ToggleDesktopIcons_Click">
            <MenuItem.Icon><TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ToggleLockPositionMenuItem" Header="{DynamicResource Str.Desktop.Menu.LockPosition}" Click="ToggleLockPosition_Click">
            <MenuItem.Icon><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{DynamicResource Str.Desktop.ResetPosition}" Click="ResetPositions_Click">
            <MenuItem.Icon><TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{DynamicResource Str.Desktop.Menu.DesktopSettings}" Click="DesktopSettings_Click">
            <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
          <Separator/>
          <MenuItem Header="{DynamicResource Str.Desktop.Menu.HideDesktopContainers}" Click="DisableDesktopContainers_Click">
            <MenuItem.Icon><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" HorizontalAlignment="Center"/></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </Grid.ContextMenu>

      <!-- Clean Borderless Desktop Container Icon (Resting State, matches Sidebar) -->
      <Border x:Name="CompactBadge"
              Width="56"
              Height="56"
              Background="#01000000"
              BorderBrush="Transparent"
              BorderThickness="0"
              Cursor="Hand"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5"
              MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
              MouseMove="DragSurface_MouseMove"
              MouseLeftButtonUp="DragSurface_MouseLeftButtonUp">
        <Border.RenderTransform>
          <ScaleTransform x:Name="CompactIconScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Image x:Name="CompactIconImage"
               Width="46"
               Height="46"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Effect>
            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/>
          </Image.Effect>
        </Image>
      </Border>

      <!-- Expanded Container Card (Hover / Click State) -->
      <Border x:Name="BoxCard"
              Visibility="Collapsed"
              Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource Line}"
              BorderThickness="1"
              CornerRadius="16"
              Margin="6"
              Padding="10,8">
        <Border.Effect>
          <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.28"/>
        </Border.Effect>
        <StackPanel>
          <DockPanel x:Name="HeaderBar"
                     Background="Transparent"
                     Cursor="Hand"
                     MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
                     MouseMove="DragSurface_MouseMove"
                     MouseLeftButtonUp="DragSurface_MouseLeftButtonUp">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="OpenFlyoutButton"
                      Content="↗"
                      Width="24"
                      Height="22"
                      Padding="0"
                      Margin="2,0"
                      Style="{StaticResource MacHeaderPillButton}"
                      ToolTip="{DynamicResource Str.Desktop.SwitchStyleTooltip}"
                      Click="OpenInFlyout_Click"/>
              <Button x:Name="CollapseButton"
                      Content="−"
                      Width="24"
                      Height="22"
                      Padding="0"
                      Margin="2,0,0,0"
                      Style="{StaticResource MacHeaderPillButton}"
                      ToolTip="{DynamicResource Str.Desktop.CollapseExpandTooltip}"
                      Click="CollapseButton_Click"/>
            </StackPanel>
            <Image x:Name="FolderIconImage" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="FolderNameText" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
            <Border Background="{DynamicResource Hover}" CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock x:Name="CountBadgeText" FontSize="10" Foreground="{DynamicResource Muted}"/>
            </Border>
          </DockPanel>

          <Grid x:Name="ContentGrid" Margin="0,8,0,0">
            <TextBlock x:Name="EmptyText"
                       Text="{DynamicResource Str.Launcher.EmptyContainer}"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource Muted}"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="8,10"/>
            <ScrollViewer MaxHeight="420"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
              <ItemsControl x:Name="AppsList" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="68"
                            Height="76"
                            Margin="3"
                            Padding="3"
                            Style="{StaticResource MacTileButton}"
                            ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name}"
                            Click="AppTile_Click"
                            MouseMove="AppTile_MouseMove"
                            MouseLeave="AppTile_MouseLeave">
                      <Button.ContextMenu>
                        <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                          <MenuItem Header="{DynamicResource Str.Launcher.Menu.Launch}" Click="AppMenuLaunch_Click"/>
                          <MenuItem Header="{DynamicResource Str.Launcher.Menu.OpenFileLocation}" Click="AppMenuLocation_Click"/>
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="62">
                        <Grid HorizontalAlignment="Center" Margin="0,1,0,2">
                          <controls:AppIcon Width="36" Height="36">
                            <controls:AppIcon.Effect>
                              <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.22"/>
                            </controls:AppIcon.Effect>
                          </controls:AppIcon>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3">
                            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Accent}" Margin="1,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"/>
                            <Ellipse Width="4" Height="4" Fill="{DynamicResource Muted}" Margin="1,0" Visibility="{Binding IsLastLaunched, Converter={StaticResource BoolVisibility}}"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   MaxHeight="28"
                                   MaxWidth="60"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ShowName, Converter={StaticResource BoolVisibility}}"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 3-D Mesh Warp Viewport for Individual Box Expand/Collapse -->
    <Viewport3D x:Name="BoxWarpViewport" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="False">
      <Viewport3D.Camera>
        <PerspectiveCamera x:Name="BoxWarpCamera" Position="166,28,480" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45" NearPlaneDistance="1" FarPlaneDistance="4000"/>
      </Viewport3D.Camera>
      <ModelVisual3D>
        <ModelVisual3D.Content>
          <Model3DGroup>
            <AmbientLight Color="White"/>
            <GeometryModel3D x:Name="BoxWarpGeometryModel">
              <GeometryModel3D.Geometry>
                <MeshGeometry3D x:Name="BoxWarpMesh"/>
              </GeometryModel3D.Geometry>
            </GeometryModel3D>
          </Model3DGroup>
        </ModelVisual3D.Content>
      </ModelVisual3D>
    </Viewport3D>
  </Grid>
</Window>
